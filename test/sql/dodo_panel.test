# name: test/sql/dodo_panel.test
# description: test save table, tempfile, preserve/restore, xtset, lag/lead, bysort
# group: [sql]

require dodo

# ============================================================
# M15: save table, tempfile, preserve/restore
# ============================================================

# save as in-memory table
statement ok
use "test/data/firms.csv", clear

statement ok
save firms_mem, replace table

# use from in-memory table
statement ok
use firms_mem, clear

query I
count
----
5

# preserve/restore
statement ok
use "test/data/firms.csv", clear

statement ok
preserve

statement ok
keep if year == 2018

query I
count
----
3

statement ok
restore

query I
count
----
5

# tempfile
statement ok
use "test/data/firms.csv", clear

statement ok
keep if year == 2018

statement ok
tempfile subset

statement ok
save subset, replace

# load full data and merge with tempfile
statement ok
use "test/data/firms.csv", clear

statement ok
merge m:1 id using "_tempfiles.subset", keep(match) nogen

query I
count
----
3

statement ok
clear

# ============================================================
# M16: xtset + lag/lead operators
# ============================================================

statement ok
use "test/data/panel_ts.csv", clear

statement ok
xtset id year

# L. lag (gap-aware)
statement ok
generate lag_rev = L.revenue

statement ok
sort id year

query IIII
list
----
1	2015	100	NULL
1	2016	120	100
1	2017	150	120
1	2019	200	NULL
2	2016	500	NULL
2	2017	550	500
2	2018	600	550

# F. lead (gap-aware)
statement ok
use "test/data/panel_ts.csv", clear

statement ok
xtset id year

statement ok
generate lead_rev = F.revenue

statement ok
sort id year

query IIII
list
----
1	2015	100	120
1	2016	120	150
1	2017	150	NULL
1	2019	200	NULL
2	2016	500	550
2	2017	550	600
2	2018	600	NULL

# D. first difference
statement ok
use "test/data/panel_ts.csv", clear

statement ok
xtset id year

statement ok
generate diff = D.revenue

statement ok
sort id year

query IIII
list
----
1	2015	100	NULL
1	2016	120	20
1	2017	150	30
1	2019	200	NULL
2	2016	500	NULL
2	2017	550	50
2	2018	600	50

# L. in condition (drop if missing lag — window in WHERE)
statement ok
use "test/data/panel_ts.csv", clear

statement ok
xtset id year

statement ok
drop if missing(L.revenue)

query I
count
----
4

# tsset (alias for xtset)
statement ok
use "test/data/panel_ts.csv", clear

statement ok
tsset id year

statement ok
generate lag_rev = L.revenue

statement ok
sort id year

query I
list lag_rev
----
NULL
100
120
NULL
NULL
500
550

statement ok
clear

# ============================================================
# M17: bysort prefix and var[_n-1]
# ============================================================

# bysort: _n within groups
statement ok
use "test/data/firms.csv", clear

statement ok
bysort year: generate row = _n

statement ok
bysort year: generate n = _N

statement ok
sort year id

query IIRIII
list
----
1	Acme	1000	2017	1	2
3	Gamma	1500	2017	2	2
2	Beta	2000	2018	1	3
4	Delta	3000	2018	2	3
5	Epsilon	500	2018	3	3

# bysort with sort order: running sum
statement ok
use "test/data/panel_ts.csv", clear

statement ok
bysort id (year): generate cum_rev = sum(revenue)

statement ok
sort id year

query IIII
list
----
1	2015	100	100
1	2016	120	220
1	2017	150	370
1	2019	200	570
2	2016	500	500
2	2017	550	1050
2	2018	600	1650

# bysort: var[_n-1] positional lag (no gap check)
statement ok
use "test/data/panel_ts.csv", clear

statement ok
bysort id (year): generate prev_rev = revenue[_n-1]

statement ok
sort id year

# Note: id=1 year=2019 gets 150 (positional, ignores gap)
query IIII
list
----
1	2015	100	NULL
1	2016	120	100
1	2017	150	120
1	2019	200	150
2	2016	500	NULL
2	2017	550	500
2	2018	600	550

# bysort: generate with _n (sequential numbering)
statement ok
use "test/data/panel_ts.csv", clear

statement ok
bysort id (year): generate spell_year = _n

statement ok
sort id year

query III
list id year spell_year
----
1	2015	1
1	2016	2
1	2017	3
1	2019	4
2	2016	1
2	2017	2
2	2018	3

statement ok
clear
